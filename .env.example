# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your real credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# ------------------------------------------------------------------------------
# Testing credentials (used in debug / development)
EXPO_PUBLIC_RAZORPAY_TEST_KEY_ID=rzp_test_your_test_key_here
RAZORPAY_TEST_KEY_SECRET=your_test_secret_here
EXPO_PUBLIC_RAZORPAY_TEST_KEY_SECRET=your_test_secret_here

# Live credentials (used in production / release)
EXPO_PUBLIC_RAZORPAY_LIVE_KEY_ID=rzp_live_your_live_key_here
RAZORPAY_LIVE_KEY_SECRET=your_live_secret_here
EXPO_PUBLIC_RAZORPAY_LIVE_KEY_SECRET=your_live_secret_here

# Active defaults
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_test_key_here
RAZORPAY_KEY_SECRET=your_test_secret_here

# Mode toggle: true for test mode, false for live mode
EXPO_PUBLIC_IS_TEST_MODE=true

# ------------------------------------------------------------------------------
# 2. STORE BRANDING & CURRENCY SETTINGS
# ------------------------------------------------------------------------------
EXPO_PUBLIC_COMPANY_NAME=aa21pa-digits
EXPO_PUBLIC_COMPANY_DESC=Curated PDF E-Books & Handbooks
EXPO_PUBLIC_CURRENCY=USD
EXPO_PUBLIC_CURRENCY_SYMBOL=$
EXPO_PUBLIC_THEME_COLOR=#0c2340
EXPO_PUBLIC_SUPPORT_EMAIL=aa21pa-solutions@gmail.com

# ------------------------------------------------------------------------------
# 3. APP & API CONFIGURATION
# ------------------------------------------------------------------------------
EXPO_PUBLIC_APP_NAME=aa21pa-digits
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:8081
